--lpm_add_sub CARRY_CHAIN="MANUAL" CARRY_CHAIN_LENGTH=48 DEVICE_FAMILY="Cyclone V" LPM_PIPELINE=1 LPM_REPRESENTATION="SIGNED" LPM_WIDTH=19 ONE_INPUT_IS_CONSTANT="NO" add_sub(vcc) cin clken clock dataa datab result
